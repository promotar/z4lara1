{
    "name": "Exhibitions",
    "slug": "exhibitions",
    "identifier": "z4platform.exhibitions",
    "version": "1.10.2",
    "type": "feature",
    "status": "stable",
    "default_state": "installed_inactive",
    "description": "Independent Z4Platform Exhibitions domain for artists, artworks, manual review, fulfillment contribution, and settlements.",
    "author": "Z4Platform",
    "provider": "Modules\\Exhibition\\ExhibitionServiceProvider",
    "provider_file": "src/ExhibitionServiceProvider.php",
    "platform_version": ">=3.4.4 <4.0.0",
    "integrations": {
        "user_deletion": {
            "mode": "participant"
        }
    },
    "critical": false,
    "can_deactivate": true,
    "can_uninstall": true,
    "dependencies": [],
    "optional_dependencies": [
        "store"
    ],
    "optional_capabilities": [
        "store.catalog.products.manage",
        "store.pricing.manage",
        "store.integrations.external-sellables.v1",
        "store.integrations.external-sellable-lifecycle.v1",
        "notifications.dispatch"
    ],
    "provides": [
        "exhibitions.access",
        "exhibitions.manage",
        "exhibitions.manage_settings",
        "exhibitions.purge_data",
        "exhibitions.review",
        "exhibitions.finance",
        "exhibitions.operations",
        "exhibitions.support",
        "exhibitions.reports",
        "exhibitions.security",
        "exhibitions.artist.apply",
        "exhibitions.artist.dashboard",
        "exhibitions.audit",
        "exhibitions.readiness",
        "exhibitions.virtual_rooms.view",
        "exhibitions.virtual_rooms.manage",
        "exhibitions.virtual_rooms.publish",
        "exhibitions.virtual_slots.manage",
        "exhibitions.virtual.review",
        "exhibitions.virtual.artist.view",
        "exhibitions.virtual.artist.submit",
        "exhibitions.virtual.artist.withdraw"
    ],
    "routes": {
        "admin": {
            "file": "routes/admin.php",
            "prefix": "admin/plugins/exhibitions",
            "name": "admin.plugins.exhibitions.",
            "middleware": [
                "web",
                "auth",
                "staff",
                "permission:exhibitions.access"
            ],
            "methods": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
            ],
            "owned_paths": [
                "/admin/plugins/exhibitions",
                "/admin/plugins/exhibitions/*"
            ]
        },
        "web": {
            "file": "routes/web.php",
            "prefix": "exhibitions",
            "name": "exhibitions.",
            "middleware": [
                "web"
            ],
            "methods": [
                "GET",
                "HEAD",
                "POST"
            ],
            "owned_paths": [
                "/exhibitions",
                "/exhibitions/*"
            ]
        }
    },
    "route_ownership": {
        "admin": [
            "/admin/plugins/exhibitions",
            "/admin/plugins/exhibitions/*"
        ],
        "web": [
            "/exhibitions",
            "/exhibitions/*"
        ]
    },
    "registry": {
        "routes": {
            "exhibitions.artist.register": {
                "uri": "exhibitions/artist/register",
                "methods": [
                    "GET",
                    "HEAD"
                ],
                "description": "Unified artist account and application registration form."
            },
            "exhibitions.artist.register.store": {
                "uri": "exhibitions/artist/register",
                "methods": [
                    "POST"
                ],
                "description": "Create the artist account and submit its application atomically."
            }
        }
    },
    "functions": {
        "exhibitions.page_builder.random_artworks": {
            "description": "Register the Random Artworks element and its public renderer through the active-plugin Page Builder hook boundary."
        }
    },
    "permissions": [
        {
            "name": "exhibitions.access",
            "description": "Access the Exhibitions administration shell."
        },
        {
            "name": "exhibitions.manage",
            "description": "Manage Exhibitions publication and module operations."
        },
        {
            "name": "exhibitions.manage_settings",
            "description": "View and change Exhibitions-owned settings."
        },
        {
            "name": "exhibitions.purge_data",
            "description": "Perform explicitly confirmed destructive Exhibitions data operations."
        },
        {
            "name": "exhibitions.review",
            "description": "Perform authorized manual artist and artwork reviews."
        },
        {
            "name": "exhibitions.finance",
            "description": "Access Exhibitions finance and settlement operations."
        },
        {
            "name": "exhibitions.operations",
            "description": "Manage Exhibitions fulfillment operations."
        },
        {
            "name": "exhibitions.support",
            "description": "Manage Exhibitions support and dispute work."
        },
        {
            "name": "exhibitions.reports",
            "description": "View and export privacy-safe Exhibitions operational reports."
        },
        {
            "name": "exhibitions.security",
            "description": "Review Exhibitions security posture, retention rules and audit coverage."
        },
        {
            "name": "exhibitions.artist.apply",
            "description": "Apply to become an artist when Phase 2 is available."
        },
        {
            "name": "exhibitions.artist.dashboard",
            "description": "Access the private approved-artist dashboard when available."
        },
        {
            "name": "exhibitions.virtual_rooms.view",
            "description": "View platform-owned virtual exhibition rooms, previews and placement queues."
        },
        {
            "name": "exhibitions.virtual_rooms.manage",
            "description": "Create and configure platform-owned virtual exhibition rooms and panoramas."
        },
        {
            "name": "exhibitions.virtual_rooms.publish",
            "description": "Publish, schedule, unpublish and archive virtual exhibition rooms."
        },
        {
            "name": "exhibitions.virtual_slots.manage",
            "description": "Create and position spherical display slots in virtual rooms."
        },
        {
            "name": "exhibitions.virtual.review",
            "description": "Review, reposition, approve, reject and remove virtual placement requests."
        },
        {
            "name": "exhibitions.virtual.artist.view",
            "description": "View the approved artist virtual exhibition workspace."
        },
        {
            "name": "exhibitions.virtual.artist.submit",
            "description": "Submit eligible owned artwork to an available platform display slot."
        },
        {
            "name": "exhibitions.virtual.artist.withdraw",
            "description": "Withdraw an owned pending virtual exhibition placement request."
        }
    ],
