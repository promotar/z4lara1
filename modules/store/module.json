        "route": "admin.plugins.store.settings.index"
    },
    "integrations": {
        "user_deletion": {
            "mode": "participant"
        }
    },
    "critical": false,
    "can_deactivate": true,
    "can_uninstall": true,
    "dependencies": [],
    "optional_dependencies": [],
