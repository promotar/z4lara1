{
    "name": "Store",
    "slug": "store",
    "identifier": "z4platform.store",
    "version": "12.10.6",
    "type": "feature",
    "status": "stable",
    "default_state": "installed_inactive",
    "description": "Independent Z4Platform Store with catalog, cart, Cash on Delivery checkout, fulfillment, and a customer purchase area integrated with the platform account.",
    "author": "Z4Platform",
    "provider": "Modules\\Store\\StoreServiceProvider",
    "provider_file": "src/StoreServiceProvider.php",
