        },
        {
            "name": "store.attributes.view",
            "description": "View Store attributes and options."
        },
        {
            "name": "store.attributes.manage",
            "description": "Manage typed Store attributes and options."
        },
        {
            "name": "store.media.associate",
            "description": "Associate validated media with products and variants."
        },
        {
            "name": "store.pricing.view",
            "description": "View variant price history and effective prices."
        },
        {
            "name": "store.pricing.manage",
            "description": "Manage regular and scheduled sale prices."
        },
        {
            "name": "store.promotions.view",
            "description": "View Store promotions."
        },
        {
            "name": "store.promotions.manage",
            "description": "Manage Store promotion rules and actions."
        },
        {
            "name": "store.shipping.view",
            "description": "View shipping zones and delivery rules."
        },
        {
            "name": "store.shipping.manage",
            "description": "Manage shipping zones, costs, free delivery thresholds, and estimates."
        },
        {
            "name": "store.inventory.view",
            "description": "View inventory balances, reservations, and ledger history."
        },
        {
            "name": "store.inventory.manage",
            "description": "Adjust and reconcile inventory."
        },
        {
            "name": "store.inventory.reserve",
            "description": "Reserve, release, and commit inventory atomically."
        },
        {
            "name": "store.orders.view",
            "description": "View the order queue and fulfillment counts."
        },
        {
            "name": "store.orders.details",
            "description": "Open complete order details and immutable snapshots."
        },
        {
            "name": "store.orders.update",
            "description": "Move orders through allowed fulfillment statuses."
        },
        {
            "name": "store.orders.cancel",
            "description": "Cancel orders with a recorded reason and release inventory."
        },
        {
            "name": "store.orders.delete",
            "description": "Permanently delete cancelled orders after explicit order-number confirmation."
        },
        {
            "name": "store.orders.return",
            "description": "Record full-order returns and decide whether stock is restored."
        },
        {
            "name": "store.orders.override",
            "description": "Perform a supervised non-standard status transition with a mandatory reason."
        },
        {
            "name": "store.orders.notes",
            "description": "Add internal append-only order notes."
        },
        {
            "name": "store.orders.print",
            "description": "Print warehouse and delivery summaries."
        },
        {
            "name": "store.orders.customer.view",
            "description": "View customer contact and delivery information."
        },
        {
            "name": "store.orders.payment",
            "description": "Record Cash on Delivery collection status."
        },
        {
            "name": "store.orders.notify",
            "description": "Send or resend Store-owned customer status emails."
        },
        {
            "name": "store.orders.reports",
            "description": "View order reporting surfaces."
        }
