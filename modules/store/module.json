        "store.access",
        "store.manage",
        "store.settings.view",
        "store.settings.update",
        "store.templates.manage",
        "store.catalog.products.read",
        "store.catalog.products.manage",
        "store.catalog.products.publish",
        "store.integrations.external-sellables.v1",
        "store.integrations.external-sellable-lifecycle.v1",
        "store.catalog.variants.read",
        "store.catalog.variants.manage",
        "store.categories.read",
        "store.categories.manage",
        "store.attributes.read",
        "store.attributes.manage",
        "store.media.read",
        "store.media.associate",
        "store.pricing.read",
        "store.pricing.manage",
        "store.promotions.read",
        "store.promotions.manage",
        "store.inventory.read",
        "store.inventory.manage",
        "store.inventory.reserve",
        "store.cart",
        "store.checkout",
        "store.orders.create",
        "store.orders.manage",
        "store.orders.fulfill",
        "store.orders.return",
        "store.orders.notify",
        "store.customer.account",
        "store.customer.addresses",
        "store.coupons.apply",
        "store.coupons.manage",
        "store.shipping.quote",
        "store.shipping.manage",
        "store.payments.cod"
    ],
    "routes": {
        "admin": {
            "file": "routes/admin.php",
            "prefix": "admin/plugins/store",
            "name": "admin.plugins.store.",
            "middleware": [
                "web",
                "auth",
                "staff",
                "permission:store.access"
            ],
            "owned_paths": [
                "/admin/plugins/store",
                "/admin/plugins/store/*"
            ]
        },
        "web": {
            "file": "routes/storefront.php",
            "prefix": "store",
            "name": "store.",
            "methods": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
            ],
            "middleware": [
                "web"
            ],
            "owned_paths": [
                "/store",
                "/store/*"
            ]
        }
    },
    "route_ownership": {
        "admin": [
            "/admin/plugins/store",
            "/admin/plugins/store/*"
        ],
        "storefront": [
            "/store",
            "/store/*"
        ]
    },
    "permissions": [
